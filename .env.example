# memsave runtime configuration.
# Copy to .env and fill the vision key.

HOST=0.0.0.0
PORT=8780
MEMSAVE_DATA_DIR=./data

# Docker Compose only: host port, host bind address and data directory.
MEMSAVE_PORT=8780
MEMSAVE_BIND_ADDR=10.77.77.21
MEMSAVE_HOST_DATA_DIR=./data

# OpenAI-compatible vision endpoint (the same mechanism as duosave).
MEMSAVE_VISION_API_KEY=
MEMSAVE_VISION_MODEL=deepseek/deepseek-v4.1-flash
MEMSAVE_VISION_BASE_URL=https://openrouter.ai/api/v1
MEMSAVE_VISION_TIMEOUT=60
MEMSAVE_VISION_MAX_MB=10
MEMSAVE_VISION_RETRIES=5

# Upload and link limits.
MEMSAVE_MAX_UPLOAD_MB=20
MEMSAVE_MAX_PIXELS=40000000
MEMSAVE_LINK_TIMEOUT=15
MEMSAVE_LINK_MAX_HTML_MB=3
MEMSAVE_LINK_MAX_REDIRECTS=5
MEMSAVE_LINK_MAX_IMAGE_MB=20

# Background jobs (set MEMSAVE_JOBS=0 for tests).
MEMSAVE_JOBS=1
MEMSAVE_PREPARE_WORKERS=2
MEMSAVE_RECOGNIZE_WORKERS=1
MEMSAVE_EMBED_WORKERS=1
MEMSAVE_LINK_WORKERS=1

# Local multilingual embeddings (fastembed).
MEMSAVE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMSAVE_EMBEDDING_DIM=384
MEMSAVE_SEMANTIC_MIN_SCORE=0.18
MEMSAVE_SEMANTIC_RELATIVE_SCORE=0.65

# Used by /api/version when the checkout has no usable git remote.
MEMSAVE_REPO_URL=https://github.com/northis/memsave
