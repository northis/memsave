{
  "manifest_version": 3,
  "name": "memsave",
  "version": "1.0.1",
  "description": "Отправить картинку из контекстного меню в личный архив memsave.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "http://localhost:8780/*",
    "http://127.0.0.1:8780/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "memsave",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
